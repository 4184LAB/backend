# backend/.env 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올리지 않습니다)
# 읽는 곳: NestJS ConfigModule(src/config/env.schema.ts로 검증), Prisma CLI, docker compose
# 로컬 docker DB를 쓸 때는 모든 값을 직접 정해도 됩니다.
# 팀 공용 DB에 접속하거나 팀원과 토큰을 공유해야 할 때만 팀에서 값을 받으세요.

# 서버 포트 (선택, 기본 3001) - src/main.ts
# 선택 항목은 빈 값(PORT=)으로 두면 0으로 바뀌어 기본값이 적용되지 않습니다. 쓸 때만 주석을 풀고 값을 넣으세요.
# PORT=

# PostgreSQL 계정 이름 (필수, 2자 이상) - docker-compose.yaml
POSTGRES_USER=

# PostgreSQL 비밀번호 (필수) - docker-compose.yaml
POSTGRES_PASSWORD=

# 데이터베이스 이름 (필수) - docker-compose.yaml의 POSTGRES_DB로 전달
POSTGRES_DATABASE=

# 호스트에 노출할 DB 포트 (compose에는 기본값이 없어서 꼭 적어야 함. 앱 스키마 기본값은 15432)
POSTGRES_PORT=

# Prisma 연결 문자열 (필수, URL 형식) - prisma/schema.prisma
# 위 값들과 맞춰서 작성: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DATABASE>
DATABASE_URL=

# JWT 서명 키 (필수, HS256) - src/api/auth/auth.module.ts, jwt/jwt.strategy.ts
# 로컬에서는 임의의 긴 랜덤 문자열이면 됩니다. 팀원과 토큰을 공유하려면 같은 값을 써야 합니다.
JWT_SECRET=

# accessToken 만료 시간, 초 단위 (선택, 기본 900)
# JWT_EXPIRES_IN_SECONDS=
